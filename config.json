px !important; }\n    .pro-brand-capsule img, .pro-brand-capsule .avatar { width: 44px !important; height: 44px !important; margin-right: 12px !important; }\n    .pro-brand-title { font-size: 18px !important; }\n    .pro-brand-subtitle { font-size: 10px !important; }\n    .subTitle { padding: 16px 18px !important; font-size: 13.5px !important; }\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    // 1. 自动生成品牌胶囊\n    let avatarImg = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n    if (avatarImg && !document.getElementById(\"proBrandCapsule\")) {\n        let capsule = document.createElement(\"a\");\n        capsule.id = \"proBrandCapsule\";\n        capsule.href = \"https://tghaocc.github.io\";\n        capsule.className = \"pro-brand-capsule\";\n        \n        let textDiv = document.createElement(\"div\");\n        textDiv.className = \"pro-brand-text\";\n        textDiv.innerHTML = '<span class=\"pro-brand-title\">科技岛</span><span class=\"pro-brand-subtitle\">GLOBAL STORE</span>';\n        \n        let parent = avatarImg.parentNode;\n        parent.insertBefore(capsule, avatarImg);\n        capsule.appendChild(avatarImg);\n        capsule.appendChild(textDiv);\n    }\n\n    // 2. 自动为欢迎词注入类似图6的“系统公告”精美头部标签\n    let subTitleElem = document.querySelector(\".subTitle\");\n    if (subTitleElem && !document.getElementById(\"noticeBadgeBox\")) {\n        let badgeBox = document.createElement(\"div\");\n        badgeBox.id = \"noticeBadgeBox\";\n        badgeBox.style.cssText = \"display: flex; align-items: center; margin-bottom: 10px; gap: 8px;\";\n        badgeBox.innerHTML = '<span style=\"background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(124,58,237,0.4);\">📢 系统公告</span><span style=\"background: rgba(255,255,255,0.1); color: #c084fc; font-size: 11px; fon