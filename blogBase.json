{"singlePage": [], "startSite": "", "filingNum": "", "onePageListNum": 15, "commentLabelColor": "#006b75", "yearColorList": ["#bc4c00", "#0969da", "#1f883d", "#A333D0"], "i18n": "CN", "themeMode": "manual", "dayTheme": "light", "nightTheme": "dark", "urlMode": "pinyin", "script": "", "style": "", "head": "", "indexScript": "", "indexStyle": "", "bottomText": "", "showPostSource": 1, "iconList": {}, "UTC": 8, "rssSplit": "sentence", "exlink": {}, "needComment": 1, "allHead": "<link rel=\"canonical\" href=\"https://tghaocc.github.io/\">\n<meta name=\"robots\" content=\"index, follow\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6\">\n<meta property=\"og:description\" content=\"\u79d1\u6280\u5c9b\u662f\u4e13\u4e1a\u76842026\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u6d77\u5916AppleID\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7a33\u5b9a\u53ef\u7528\u7684\u7f8e\u533a\u3001\u65e5\u533a\u3001\u6e2f\u533a\u82f9\u679c\u8d26\u53f7\u53ca\u5bc6\u7801\uff0c\u4e00\u7ad9\u5f0f\u89e3\u51b3App Store\u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53caShadowrocket\uff08\u5c0f\u706b\u7bad\uff09\u4e0b\u8f7d\u96be\u9898\u3002\">\n<meta property=\"og:url\" content=\"https://tghaocc.github.io/\">\n<style>\n/* \ud83c\udf1f \u54c1\u724c\u80f6\u56ca\u5361\u7247\uff1a\u5b8c\u7f8e\u590d\u523b\u56fe5\u7d2b\u7f57\u5170\u6e10\u53d8\u4e0e\u593a\u76ee\u626b\u5149 */\n.pro-brand-capsule {\n    position: relative;\n    overflow: hidden;\n    display: inline-flex !important;\n    align-items: center;\n    padding: 12px 24px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 240, 255, 0.95) 100%) !important;\n    border: 2px solid rgba(147, 112, 219, 0.45) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 10px 28px rgba(138, 43, 226, 0.12), inset 0 1px 2px rgba(255, 255, 255, 0.9) !important;\n    text-decoration: none !important;\n    vertical-align: middle;\n    margin: 8px 0;\n    backdrop-filter: blur(16px);\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.pro-brand-capsule::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(60deg, transparent 35%, rgba(255, 255, 255, 0.85) 50%, transparent 65%);\n    transform: translateX(-100%);\n    animation: glaringSweep 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n}\n\n@keyframes glaringSweep {\n    0% { transform: translateX(-100%); }\n    30% { transform: translateX(100%); }\n    100% { transform: translateX(100%); }\n}\n\n.pro-brand-capsule:hover {\n    transform: translateY(-3px) scale(1.02);\n    box-shadow: 0 14px 35px rgba(138, 43, 226, 0.22) !important;\n    border-color: rgba(147, 112, 219, 0.8) !important;\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 54px !important;\n    height: 54px !important;\n    border-radius: 15px !important;\n    object-fit: cover;\n    margin-right: 14px !important;\n    border: 1px solid rgba(147, 112, 219, 0.2);\n    box-shadow: 0 4px 12px rgba(138, 43, 226, 0.1);\n    position: relative;\n    z-index: 1;\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    line-height: 1.3;\n    position: relative;\n    z-index: 1;\n}\n\n.pro-brand-title {\n    font-size: 22px !important;\n    font-weight: 800 !important;\n    background: linear-gradient(135deg, #7b2cbf 0%, #3a86ff 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: 0.8px;\n}\n\n.pro-brand-subtitle {\n    font-size: 11px !important;\n    font-weight: 700 !important;\n    color: #6c757d !important;\n    letter-spacing: 2.5px;\n    margin-top: 4px;\n    text-transform: uppercase;\n}\n\n/* \ud83c\udf1f \u6b22\u8fce\u8bcd\u91cd\u6784\uff1a\u4eff\u56fe6\u7cfb\u7edf\u516c\u544a\u5927\u5361\u7247\u98ce\u683c\uff08\u6e29\u99a8\u9ad8\u5b9a\u6e10\u53d8\u8272\uff09 */\n.subTitle {\n    position: relative;\n    overflow: hidden;\n    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e293b 100%) !important;\n    border: 1.5px solid rgba(167, 139, 250, 0.35) !important;\n    border-radius: 20px !important;\n    padding: 22px 24px !important;\n    margin: 18px 0 !important;\n    box-shadow: 0 14px 35px rgba(30, 27, 75, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.15) !important;\n    color: #f1f5f9 !important;\n    font-weight: 500 !important;\n    font-size: 14.5px !important;\n    line-height: 1.85 !important;\n}\n\n/* \u516c\u544a\u5361\u7247\u5185\u90e8\u6d41\u5149\u7279\u6548 */\n.subTitle::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);\n    animation: cardSweep 6s ease-in-out infinite;\n}\n\n@keyframes cardSweep {\n    0% { left: -100%; }\n    50% { left: 100%; }\n    100% { left: 100%; }\n}\n\n@media (max-width: 600px) {\n    .pro-brand-capsule { padding: 8px 16px !important; border-radius: 22px !important; }\n    .pro-brand-capsule img, .pro-brand-capsule .avatar { width: 44px !important; height: 44px !important; margin-right: 12px !important; }\n    .pro-brand-title { font-size: 18px !important; }\n    .pro-brand-subtitle { font-size: 10px !important; }\n    .subTitle { padding: 16px 18px !important; font-size: 13.5px !important; }\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    // 1. \u81ea\u52a8\u751f\u6210\u54c1\u724c\u80f6\u56ca\n    let avatarImg = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n    if (avatarImg && !document.getElementById(\"proBrandCapsule\")) {\n        let capsule = document.createElement(\"a\");\n        capsule.id = \"proBrandCapsule\";\n        capsule.href = \"https://tghaocc.github.io\";\n        capsule.className = \"pro-brand-capsule\";\n        \n        let textDiv = document.createElement(\"div\");\n        textDiv.className = \"pro-brand-text\";\n        textDiv.innerHTML = '<span class=\"pro-brand-title\">\u79d1\u6280\u5c9b</span><span class=\"pro-brand-subtitle\">GLOBAL STORE</span>';\n        \n        let parent = avatarImg.parentNode;\n        parent.insertBefore(capsule, avatarImg);\n        capsule.appendChild(avatarImg);\n        capsule.appendChild(textDiv);\n    }\n\n    // 2. \u81ea\u52a8\u4e3a\u6b22\u8fce\u8bcd\u6ce8\u5165\u7c7b\u4f3c\u56fe6\u7684\u201c\u7cfb\u7edf\u516c\u544a\u201d\u7cbe\u7f8e\u5934\u90e8\u6807\u7b7e\n    let subTitleElem = document.querySelector(\".subTitle\");\n    if (subTitleElem && !document.getElementById(\"noticeBadgeBox\")) {\n        let badgeBox = document.createElement(\"div\");\n        badgeBox.id = \"noticeBadgeBox\";\n        badgeBox.style.cssText = \"display: flex; align-items: center; margin-bottom: 10px; gap: 8px;\";\n        badgeBox.innerHTML = '<span style=\"background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 6px; letter-spacing: 0.5px; box-shadow: 0 2px 6px rgba(124,58,237,0.4);\">\ud83d\udce2 \u7cfb\u7edf\u516c\u544a</span><span style=\"background: rgba(255,255,255,0.1); color: #c084fc; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 6px;\">\u5e73\u53f0\u6307\u5357</span>';\n        subTitleElem.insertBefore(badgeBox, subTitleElem.firstChild);\n    }\n});\n</script>", "title": "\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6", "subTitle": "\u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01\u6211\u4eec\u957f\u671f\u4e3a\u60a8\u63d0\u4f9b\u7a33\u5b9a\u3001\u5b89\u5168\u7684\u7f8e\u533a\u3001\u6e2f\u533a\u3001\u65e5\u533a App Store \u8d26\