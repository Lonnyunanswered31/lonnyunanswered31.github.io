  text-decoration: none !important;\n    vertical-align: middle;\n    margin: 6px 0;\n    backdrop-filter: blur(16px);\n    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);\n}\n\n.pro-brand-capsule:hover {\n    border-color: rgba(0, 122, 255, 0.4) !important;\n    box-shadow: 0 12px 32px rgba(0, 113, 227, 0.15), inset 0 1px 1px rgba(255, 255, 255, 1) !important;\n    transform: translateY(-1px);\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 50px !important;\n    height: 50px !important;\n    border-radius: 15px !important;\n    object-fit: cover;\n    margin-right: 14px !important;\n    border: 1px solid rgba(0, 0, 0, 0.06);\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    line-height: 1.3;\n}\n\n/* \u6e10\u53d8\u827a\u672f\u5b57\u4e3b\u6807\u9898 */\n.pro-brand-title {\n    font-size: 20px !important;\n    font-weight: 800 !important;\n    background: linear-gradient(135deg, #111115 0%, #0066cc 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: 0.8px;\n}\n\n/* \u6781\u7b80\u9ad8\u7ea7\u611f\u526f\u6807\u9898 */\n.pro-brand-subtitle {\n    font-size: 11px !important;\n    font-weight: 700 !important;\n    color: #0066cc !important;\n    letter-spacing: 2px;\n    margin-top: 3px;\n    text-transform: uppercase;\n    opacity: 0.9;\n}\n\n/* \u79fb\u52a8\u7aef\u9ad8\u5b9a\u9002\u914d */\n@media (max-width: 600px) {\n    .pro-brand-capsule { padding: 8px 16px !important; border-radius: 20px !important; }\n    .pro-brand-capsule img, .pro-brand-capsule .avatar { width: 42px !important; height: 42px !important; margin-right: 12px !important; }\n    .pro-brand-title { font-size: 17px !important; }\n    .pro-brand-subtitle { font-size: 10px !important; }\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    let avatarImg = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n    if (avatarImg && !document.getElementById(\"proBrandCapsule\")) {\n        let capsule = document.createElement(\"a\");\n        capsule.id = \"proBrandCapsule\";\n        capsule.href = \"https://tghaocc.github.io\";\n        capsule.className = \"pro-brand-capsule\";\n        \n        let textDiv = document.createElement(\"div\");\n        textDiv.className = \"pro-brand-text\";\n        textDiv.innerHTML = '<span class=\"pro-brand-title\">\u79d1\u6280\u5c9b</span><span class=\"pro-brand-subtitle\">GLOBAL STORE</span>';\n        \n        let parent = avatarImg.parentNode;\n        parent.insertBefore(capsule, avatarImg);\n        capsule.appendChild(avatarImg);\n        capsule.appendChild(textDiv);\n    }\n});\n</script>", "title": "\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6", "subTitle": "<div style=\"background: linear-gradient(135deg, rgba(255,255,255,0.85) 0%, rgba(244,247,252,0.95) 100%); border: 1px solid rgba(0, 122, 255, 0.15); border-radius: 16px; padding: 18px 22px; margin: 16px 0; box-shadow: 0 10px 30px rgba(0, 102, 204, 0.05); backdrop-filter: blur(12px);\"><span style=\"color: #1d1d1f; font-weight: 600; font-size: 15px; line-height: 1.8; display: block; letter-spacing: 0.3px;\">\u2728 \u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01\u6211\u4eec\u957f\u671f\u4e3a\u60a8\u63d0\u4f9b\u7a33\u5b9a\u3001\u5b89\u5168\u7684\u7f8e\u533a\u3001\u6e2f\u533a\u3001\u65e5\u533a App Store \u8d26\u53f7\u4e0e\u6d77\u5916 Apple ID \u83b7\u53d6\u6307\u5357\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u8f7b\u677e\u83b7\u53d6\u5b9e\u65f6\u66f4\u65b0\u7684\u5171\u4eab\u8d26\u53f7\uff0c\u5e76\u89e3\u51b3 iOS \u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53ca\u8f6f\u4ef6\u4e0b\u8f7d\u7b49\u5e38\u89c1\u95ee\u9898\uff0c\u4e00\u7ad9\u5f0f\u89e3\u9501\u5168\u7403\u7cbe\u5f69\u5e94\u7528\u4e0e\u6e38\u620f\u3002</span></div>", "descripti